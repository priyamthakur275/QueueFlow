# For running the backend directly (outside Docker). Never commit a populated .env.
ENV=development
DATABASE_URL=postgresql://queueflow_app:CHANGE_ME@localhost:5432/queueflow
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
PUBLIC_APP_URL=http://localhost:5173
COOKIE_SECURE=false
# Optional: see the root .env.example for SMTP_*, LLM_* and EMBEDDING_* settings.
